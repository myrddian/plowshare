{
  "name": "plowshare-desktop",
  "productName": "Plowshare",
  "version": "0.1.0",
  "private": true,
  "description": "Plowshare remote agent workspace",
  "type": "module",
  "main": "build/main.cjs",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/filestores.test.ts src/application-files.test.ts src/personal.test.ts src/profile.test.ts src/client.test.ts src/job-store.test.ts src/operator.test.ts src/caps.test.ts src/activity.test.ts src/library.test.ts src/retained-report.test.ts src/sync.test.ts src/schedules.test.ts src/runs.test.ts src/workspace.test.ts src/project-config.test.ts src/connection-config.test.ts src/connections.test.ts src/files.test.ts src/board.test.ts src/renderer/markdown.test.ts src/renderer/approvals.test.ts src/renderer/question-popup.test.ts src/renderer/commands.test.ts",
    "test:reports-reader": "node scripts/build.mjs && node scripts/reports-reader-smoke.mjs",
    "test:info-board": "node scripts/build.mjs && node scripts/info-board-smoke.mjs",
    "test:relay": "node scripts/build.mjs && node scripts/relay-smoke.mjs",
    "test:board": "node scripts/build.mjs && node --experimental-strip-types scripts/board-smoke.mjs",
    "test:electron": "node scripts/build.mjs && node --experimental-strip-types scripts/smoke.mjs",
    "test:panes": "node scripts/build.mjs && node scripts/panes-smoke.mjs",
    "test:navigation": "node scripts/build.mjs && node --experimental-strip-types scripts/navigation-smoke.mjs",
    "test:applications": "node scripts/build.mjs && node --experimental-strip-types scripts/applications-smoke.mjs",
    "test:application-storage": "node scripts/build.mjs && node --experimental-strip-types scripts/application-storage-smoke.mjs",
    "test:projects": "node scripts/build.mjs && node --experimental-strip-types scripts/projects-smoke.mjs",
    "test:personal": "node scripts/build.mjs && node --experimental-strip-types scripts/personal-smoke.mjs",
    "test:bots": "node scripts/build.mjs && node --experimental-strip-types scripts/bots-smoke.mjs",
    "test:pricing": "node scripts/build.mjs && node --experimental-strip-types scripts/pricing-smoke.mjs",
    "test:admin": "node scripts/build.mjs && node --experimental-strip-types scripts/admin-smoke.mjs",
    "test:login": "node scripts/build.mjs && node --experimental-strip-types scripts/login-smoke.mjs",
    "test:files": "node scripts/build.mjs && node --experimental-strip-types scripts/files-smoke.mjs",
    "test:approvals": "node scripts/build.mjs && node --experimental-strip-types scripts/approvals-smoke.mjs",
    "test:questions": "node scripts/build.mjs && node --experimental-strip-types scripts/questions-smoke.mjs",
    "test:report-handoff": "node scripts/build.mjs && node --experimental-strip-types scripts/report-handoff-smoke.mjs",
    "test:runs": "node scripts/build.mjs && node --experimental-strip-types scripts/runs-smoke.mjs",
    "test:run-navigation": "node scripts/build.mjs && node --experimental-strip-types scripts/run-navigation-smoke.mjs",
    "test:library": "node scripts/library-smoke.mjs",
    "test:information": "node scripts/build.mjs && node --experimental-strip-types scripts/information-smoke.mjs",
    "test:sync": "node scripts/build.mjs && node scripts/sync-smoke.mjs",
    "test:builder": "node scripts/build.mjs && node --experimental-strip-types scripts/builder-smoke.mjs",
    "test:controls": "node scripts/build.mjs && node --experimental-strip-types scripts/controls-smoke.mjs",
    "test:transport": "node scripts/build.mjs && node --experimental-strip-types scripts/transport-smoke.mjs",
    "test:recovery": "node scripts/build.mjs && node --experimental-strip-types scripts/recovery-smoke.mjs",
    "test:commands": "node scripts/build.mjs && node --experimental-strip-types scripts/commands-smoke.mjs",
    "test:usage": "node scripts/build.mjs && node --experimental-strip-types scripts/usage-smoke.mjs",
    "test:screens": "node scripts/build.mjs && node --experimental-strip-types scripts/screens-smoke.mjs",
    "test:connections": "node scripts/build.mjs && node scripts/connections-smoke.mjs",
    "test:multiple-clients": "node scripts/build.mjs && node scripts/multiple-clients-smoke.mjs",
    "test:filestores": "node scripts/build.mjs && node scripts/filestores-smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@types/node": "^22.20.2",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "plowshare-client-node": "link:../sdk/node",
    "plowshare-client-ts": "link:../sdk/typescript"
  }
}
