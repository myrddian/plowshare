#!/usr/bin/env bash
# Load an operator-owned environment file without evaluating shell code, then
# launch the server. Exported values win over file values; launcher flags win
# over both. A Spring overlay describes the complete inference topology.

set -euo pipefail

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPLOYMENT="${PLOWSHARE_DEPLOYMENT:-$HOME/.config/plowshare/deployment.env}"

if [[ ! -f "$DEPLOYMENT" ]]; then
    echo "plowshare-deployment: no file at $DEPLOYMENT" >&2
    echo "                      cp $HERE/deployment.env.example '$DEPLOYMENT'" >&2
    echo "                      then edit it. Or run bin/plowshare directly," >&2
    echo "                      which requires explicit inference and server configuration." >&2
    exit 1
fi

# Only names the caller left unset, so an exported variable still wins. A line
# is a comment when its first non-space character is '#'; nothing strips a '#'
# out of the middle of a value, because a URL may legitimately carry one.
while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "${trimmed:0:1}" == "#" || "$trimmed" != *=* ]] && continue

    key="${trimmed%%=*}"
    value="${trimmed#*=}"
    key="${key//[[:space:]]/}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue

    value="${value%"${value##*[![:space:]]}"}"
    if [[ "${value:0:1}" == '"' && "${value: -1}" == '"' && ${#value} -ge 2 ]]; then
        value="${value:1:${#value}-2}"
    elif [[ "${value:0:1}" == "'" && "${value: -1}" == "'" && ${#value} -ge 2 ]]; then
        value="${value:1:${#value}-2}"
    fi

    if [[ -z "${!key:-}" ]]; then
        export "$key=$value"
    fi
done < "$DEPLOYMENT"

# An explicitly named overlay must exist. Never silently ignore a missing
# deployment file and fall back to another inference topology.
OVERLAY="${PLOWSHARE_CONFIG_OVERLAY:-$HOME/.config/plowshare/application-local.yml}"
if [[ -z "${SPRING_CONFIG_ADDITIONAL_LOCATION:-}" ]]; then
    if [[ -f "$OVERLAY" ]]; then
        export PLOWSHARE_CONFIG_OVERLAY="$OVERLAY"
    elif [[ -n "${PLOWSHARE_CONFIG_OVERLAY:-}" ]]; then
        echo "plowshare-deployment: configuration file does not exist: $OVERLAY" >&2
        exit 1
    fi
fi

exec "$HERE/plowshare" "$@"
