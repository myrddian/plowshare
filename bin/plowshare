#!/usr/bin/env bash
# Launch using an explicit environment or external Spring configuration.
# Pool/model selection belongs to configuration, never to this launcher.
set -euo pipefail
readonly REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD=1
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)
            if [[ $# -lt 2 || -z "$2" || "$2" == --* ]]; then
                echo 'plowshare: --config requires an external Spring configuration file.' >&2
                exit 2
            fi
            if [[ ! -f "$2" ]]; then
                echo 'plowshare: configuration file does not exist.' >&2
                exit 2
            fi
            config="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
            export SPRING_CONFIG_ADDITIONAL_LOCATION="file:$config"
            shift 2 ;;
        --no-build) BUILD=0; shift ;;
        --) shift; break ;;
        -h|--help)
            cat <<'USAGE'
Usage: bin/plowshare [--config FILE] [--no-build] [-- SPRING_ARGUMENTS...]

Supply server, database, storage and model settings through the environment or
an external Spring configuration file. No environment/credential file is loaded.
The packaged configuration supports one pool; a supplied file can declare any
pool topology. Missing settings are validated by the server at startup.
Use -- to pass Spring arguments, for example -- --server.port=18091.

Running servers use an immutable jar copy in the user cache. Set
PLOWSHARE_RUNTIME_DIR to choose its location; retain copies while in use.
USAGE
            exit 0 ;;
        *) echo 'plowshare: unknown launcher option; see --help.' >&2; exit 2 ;;
    esac
done
if [[ "${PLOWSHARE_AUTH_ENABLED:-true}" == false && "${PLOWSHARE_BIND:-}" != 127.0.0.1 ]]; then
    echo 'plowshare: disabling authentication requires an explicit loopback bind.' >&2
    exit 2
fi
cd "$REPO/plowshare-server"
if [[ "$BUILD" == 1 ]]; then
    "$REPO/gradlew" --quiet :plowshare-server:bootJar
fi
jar=""
for candidate in build/libs/*.jar; do
    [[ -f "$candidate" && "$candidate" != *-plain.jar ]] || continue
    if [[ -n "$jar" ]]; then
        echo 'plowshare: multiple executable jars; clean and rebuild the server.' >&2
        exit 1
    fi
    jar="$candidate"
done
if [[ -z "$jar" ]]; then
    echo 'plowshare: build the server with ./gradlew :plowshare-server:bootJar.' >&2
    exit 1
fi

# Boot loads classes lazily. An atomic, content-addressed copy keeps an existing
# JVM safe when another build replaces build/libs. exec preserves signal delivery.
runtime_dir="${PLOWSHARE_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/plowshare/server}"
mkdir -p "$runtime_dir"
runtime_dir="$(cd "$runtime_dir" && pwd)"
snapshot="$(mktemp "$runtime_dir/.launch.XXXXXXXX")"
trap 'rm -f "$snapshot"' EXIT
cp "$jar" "$snapshot"
if command -v sha256sum >/dev/null 2>&1; then
    digest="$(sha256sum "$snapshot")"
elif command -v shasum >/dev/null 2>&1; then
    digest="$(shasum -a 256 "$snapshot")"
else
    echo 'plowshare: sha256sum or shasum is required.' >&2
    exit 1
fi
runtime_jar="$runtime_dir/${digest%% *}.jar"
if ! ln "$snapshot" "$runtime_jar" 2>/dev/null && [[ ! -f "$runtime_jar" ]]; then
    echo 'plowshare: could not publish the server launch snapshot.' >&2
    exit 1
fi
rm -f "$snapshot"
trap - EXIT
exec java -jar "$runtime_jar" "$@"
