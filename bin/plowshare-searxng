#!/usr/bin/env bash
# Start only the adapter. Registration is a separate public-API operation.
set -euo pipefail
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
    echo 'Usage: bin/plowshare-searxng [SPRING_ARGUMENTS...]'
    echo 'Set SEARXNG_BASE_URL, SEARXNG_BIND and SEARXNG_PORT explicitly.'
    echo 'Register separately with deploy/docker/register-search.mjs.'
    exit 0
fi
: "${SEARXNG_BASE_URL:?Set the existing SearXNG engine URL}"
: "${SEARXNG_BIND:?Set the adapter listener address}"
: "${SEARXNG_PORT:?Set the adapter listener port}"
readonly REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
jar="$REPO/extensions/search-searxng/build/libs/search-searxng-0.1.0-SNAPSHOT.jar"
if [[ ! -f "$jar" ]]; then
    echo 'Build the adapter with ./gradlew :extensions:search-searxng:bootJar.' >&2
    exit 1
fi
exec java -jar "$jar" "$@"
