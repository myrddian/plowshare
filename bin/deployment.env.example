# Copy to ~/.config/plowshare/deployment.env and edit.
#
#   cp bin/deployment.env.example ~/.config/plowshare/deployment.env
#
# bin/plowshare sources this before its own defaults, so anything set here wins
# over the loopback values committed in the script.
#
# It lives outside the repo for the reason secrets.env does -- no gitignore rule
# is load-bearing -- and for one more: bin/plowshare is tracked, and
# InvariantsTest.no_source_names_the_reference_box sweeps every tracked file
# outside docs/ for a real machine address, because no test may dial a real box.
# Keep real addresses out of this example for the same reason.

# The pool serving the `fast` class: non-reasoning, cheap, most turns.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_CHAT_MODEL=

# The pool serving the `reasoning` class.
SPARK_BASE_URL=http://127.0.0.1:8000/v1
SPARK_CHAT_MODEL=

# ---- refusal fallback (optional) ------------------------------------------
# The pool serving a low-refusal model, for agents whose definition declares
# `fallback:`. These are read ONLY by the pool in application-local.yml:
#
#   cp bin/application-local.example.yml ~/.config/plowshare/application-local.yml
#
# Without that file these lines do nothing and no agent is ever rerouted. Its
# API key, if it needs one, goes in secrets.env as FALLBACK_API_KEY.
FALLBACK_BASE_URL=
FALLBACK_CHAT_MODEL=

# Where the overlay lives, if not ~/.config/plowshare/application-local.yml.
# PLOWSHARE_CONFIG_OVERLAY=

# ---- search provider: SearXNG -------------------------------------------
# Read by bin/plowshare-searxng. The first is your own SearXNG instance; the
# second is the port the Plowshare provider process listens on, and it is that
# second address the server is registered against -- the server never talks to
# SearXNG directly. Leave the base URL blank and bin/plowshare-searxng will
# tell you so rather than start a provider that can reach nothing.
PLOWSHARE_EXT_SEARXNG_BASE_URL=
PLOWSHARE_EXT_SEARXNG_PORT=8100

# ---- console admin account ------------------------------------------------
# Set both to move the console off the operator token and onto a password
# login at POST /v1/auth/login. Leave both blank to keep booting exactly as
# you always have.
#
# PLOWSHARE_ADMIN_PASSWORD is read only at the boot that creates this
# account -- once the row exists, changing or unsetting this variable does
# nothing, and the boot will refuse to start if it is unset or an obvious
# placeholder (changeme, password, admin, and the like) the first time
# PLOWSHARE_ADMIN_HANDLE names an account that does not exist yet. The
# account is created with must_change_password set, so the first login must
# change it at POST /v1/auth/password before the session it grants can be
# renewed with a refresh token.
PLOWSHARE_ADMIN_HANDLE=
PLOWSHARE_ADMIN_PASSWORD=
