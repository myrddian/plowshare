# Copy outside Git to ~/.config/plowshare/deployment.env and edit.
# bin/plowshare-deployment reads literal NAME=value lines; exported values win.
# Supply every address/path for your deployment; blank values are incomplete.
PLOWSHARE_DB_URL=
PLOWSHARE_DB_USER=
PLOWSHARE_PORT=
PLOWSHARE_BIND=
PLOWSHARE_DATA_DIR=
PLOWSHARE_PROJECTS_WORKSPACE_DIRECTORY=
PLOWSHARE_AUTH_ENABLED=true

# Generic single endpoint serving both chat and the existing embedding model.
# Put LLM_API_KEY and PLOWSHARE_DB_PASSWORD in the mode-0600 secrets file.
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_PROVIDER=openai
LLM_CHAT_SLOTS=1
LLM_EMBEDDING_SLOTS=1
LLM_SWARM_SLOTS=0

# For any other topology, copy application-local.example.yml outside Git and
# select it here. Define its MODEL_* placeholders in this file or the environment.
# PLOWSHARE_CONFIG_OVERLAY=/absolute/path/application-local.yml
# MODEL_CHAT_URL=
# MODEL_CHAT_ID=
# MODEL_EMBEDDING_URL=
# MODEL_EMBEDDING_ID=
# MODEL_CHAT_SLOTS=2
# MODEL_SWARM_SLOTS=1

# Optional global chat/fold budgets and independently configured search adapter.
# PLOWSHARE_LLM_PROMPTTIMEOUT=120s
# PLOWSHARE_LLM_FOLDTIMEOUT=10m
PLOWSHARE_EXT_SEARXNG_BASE_URL=
PLOWSHARE_EXT_SEARXNG_PORT=

# Leave administrator provisioning unset to use normal first-run CLI setup.
PLOWSHARE_ADMIN_HANDLE=
PLOWSHARE_ADMIN_PASSWORD=
