# Reference values to export with your own deployment tooling; the launcher does
# not read this file. Keep secrets outside Git and supply each endpoint explicitly.
PLOWSHARE_DB_URL=
PLOWSHARE_DB_USER=
PLOWSHARE_PORT=
PLOWSHARE_BIND=
PLOWSHARE_DATA_DIR=
PLOWSHARE_PROJECTS_WORKSPACE_DIRECTORY=
PLOWSHARE_AUTH_ENABLED=true

# One endpoint can serve chat and embeddings. Select actual wire model names.
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_PROVIDER=openai
LLM_CHAT_SLOTS=1
LLM_EMBEDDING_SLOTS=1
LLM_SWARM_SLOTS=0
# Supply LLM_API_KEY and PLOWSHARE_DB_PASSWORD externally when required.
