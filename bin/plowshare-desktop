#!/usr/bin/env bash
set -euo pipefail
DESKTOP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../plowshare-desktop" && pwd -P)"
if ! command -v node >/dev/null; then
  echo 'Install Node 22.12 or newer to run the Plowshare desktop test application.' >&2
  exit 1
fi
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || major === 22 && minor >= 12 ? 0 : 1)'; then
  echo 'The Plowshare desktop needs Node 22.12 or newer.' >&2
  exit 1
fi
if [[ ! -d "$DESKTOP_ROOT/node_modules/electron" ]]; then
  echo "Install desktop dependencies first: cd '$DESKTOP_ROOT' && pnpm install --frozen-lockfile" >&2
  exit 1
fi
if [[ ! -f "$DESKTOP_ROOT/node_modules/plowshare-client-ts/build/binding/auth.js" || ! -f "$DESKTOP_ROOT/node_modules/plowshare-client-node/build/marker.js" ]]; then
  echo 'Build the shared client first: ./gradlew :plowshare-desktop:assemble' >&2
  exit 1
fi
cd "$DESKTOP_ROOT"
node scripts/build.mjs
exec node node_modules/electron/cli.js . "$@"
