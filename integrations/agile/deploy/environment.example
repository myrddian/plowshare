AGILE_IMAGE=REPLACE_WITH_IMMUTABLE_IMAGE_ID_OR_DIGEST
AGILE_RUN_USER=REPLACE_WITH_UID:GID
AGILE_CONFIG_FILE=/absolute/private/furrow/config.toml
AGILE_TOKEN_FILE=/absolute/private/furrow/plowshare-token
AGILE_WEB_ACCESS_KEY_FILE=/absolute/private/furrow/web-access-key
AGILE_REQUEST_DIRECTORY=/absolute/private/furrow/requests
AGILE_BIND=REPLACE_WITH_CONTAINER_BIND_ADDRESS
AGILE_PORT=REPLACE_WITH_CONTAINER_PORT
AGILE_PUBLIC_ORIGIN=https://furrow.example
AGILE_HEALTH_ORIGIN=http://REPLACE_WITH_INTERNAL_LISTENER:REPLACE_WITH_CONTAINER_PORT
AGILE_LISTEN_ADDRESS=REPLACE_WITH_HOST_LISTENER_ADDRESS
AGILE_PUBLISHED_PORT=REPLACE_WITH_HOST_PORT
