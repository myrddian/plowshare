{
  "account": "your-administrator-account",
  "project": "discord",
  "serviceHandle": "discord-worker",
  "sourceDirectory": "/absolute/path/to/plowshare-public/integrations/discord/application",
  "outputDirectory": "/absolute/path/to/private/discord-installation",
  "destination": {
    "store": "your-application-filestore",
    "path": "discord"
  },
  "writableAreas": [],
  "expiresInDays": 30,
  "adapter": {
    "origin": "https://plowshare.example.invalid",
    "serviceTokenEnvironment": "PLOWSHARE_DISCORD_SERVICE_TOKEN",
    "discordTokenEnvironment": "DISCORD_BOT_TOKEN",
    "stateDirectory": "/absolute/path/to/private/discord-state",
    "allowedUserIds": [
      "100000000000000003"
    ],
    "routes": [
      {
        "guildId": "100000000000000001",
        "channelId": "100000000000000002",
        "project": "discord",
        "bot": "discord_assistant",
        "requireMention": true
      }
    ],
    "notifications": [],
    "dm": {"mode": "disabled"},
    "pollMs": 2000,
    "requestTimeoutMs": 30000,
    "maxRecords": 500
  }
}
