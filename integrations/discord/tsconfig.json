{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "build/discord",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
