{
  "version": 1,
  "name": "network-privacy-watch",
  "access": {
    "accounts": []
  },
  "caps": {
    "steps": 256,
    "budget": 200,
    "autoIncrease": false
  },
  "commands": {
    "local": {
      "mode": "off"
    },
    "server": {
      "mode": "off"
    }
  },
  "executionAccount": "REPLACE_WITH_PROVIDER_ACCOUNT",
  "toolScopes": [
    {
      "scope": "network_scanning",
      "provider": "privacy-scanner",
      "grants": [
        "network_scope",
        "network_scan",
        "network_scan_status",
        "network_scan_list",
        "network_evidence",
        "network_destinations",
        "network_devices",
        "network_device"
      ]
    },
    {
      "scope": "network_evidence_read",
      "provider": "privacy-scanner",
      "grants": [
        "network_scope",
        "network_scan_list",
        "network_evidence",
        "network_destinations",
        "network_devices",
        "network_device"
      ]
    },
    {
      "scope": "network_assistant",
      "provider": "privacy-scanner",
      "grants": [
        "network_scope",
        "network_scan_list",
        "network_evidence",
        "network_destinations",
        "network_devices",
        "network_device",
        "network_request_deep_scan",
        "network_request_assessment",
        "network_note_profile",
        "network_record_issue",
        "network_request_reference"
      ]
    }
  ],
  "toolGrants": [
    {
      "toolScope": "network_scanning",
      "agent": "privacy_coordinator"
    },
    {
      "toolScope": "network_evidence_read",
      "agent": "privacy_analyst"
    },
    {
      "toolScope": "network_evidence_read",
      "agent": "privacy_reviewer"
    },
    {
      "toolScope": "network_assistant",
      "agent": "privacy_assistant"
    }
  ]
}
