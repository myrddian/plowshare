<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every log line in this process goes to stderr. Not a preference: stdout is the
  MCP protocol channel, and one log line on it is a non-JSON-RPC line in the
  middle of the stream, which desynchronises the client for the rest of the
  session. The failure presents as the harness misbehaving — a tool call that
  never returns, or a parse error blamed on the client — so it is expensive to
  diagnose and trivial to prevent.

  This file has to exist rather than being left to defaults: logback's own
  default configuration, and Spring Boot's, both attach a ConsoleAppender whose
  target is System.out. Shipping the binding with no config would be strictly
  worse than shipping no binding at all.

  LoggingConfigTest asserts that every appender reachable from the root logger
  writes to System.err, so a future appender added here without a <target> fails
  the build instead of the protocol.
-->
<configuration>

  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- INFO and not DEBUG: this process's log shares the harness's stderr with
       everything else the harness prints, and a chatty MCP subprocess buries
       whatever the user was actually reading. -->
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>

</configuration>
