[
  { "name": "an empty file sets nothing", "text": "", "expect": { "local": null, "server": null } },
  { "name": "comments and blank lines", "text": "# a comment\n\nlocal:\n  mode: gated # inline\n", "expect": { "local": { "mode": "gated" }, "server": null } },
  { "name": "every key", "text": "local:\n  mode: open\n  shells: true\n  inherit: [PATH, JAVA_HOME]\n  env:\n    GRADLE_OPTS: -Xmx2g\n    QUOTED: \"a # not a comment\"\n  timeout: 10m\n  output: 512KiB\n  isolation: none\nserver:\n  mode: off\n", "expect": { "local": { "mode": "open", "shells": true, "inherit": ["PATH", "JAVA_HOME"], "env": { "GRADLE_OPTS": "-Xmx2g", "QUOTED": "a # not a comment" }, "timeoutMillis": 600000, "outputBytes": 524288, "isolation": "none" }, "server": { "mode": "off" } } },
  { "name": "the ask mode", "text": "local:\n  mode: ask\n", "expect": { "local": { "mode": "ask" }, "server": null } },
  { "name": "an empty inherit list", "text": "local:\n  inherit: []\n", "expect": { "local": { "inherit": [] }, "server": null } },
  { "name": "seconds", "text": "server:\n  timeout: 90s\n", "expect": { "local": null, "server": { "timeoutMillis": 90000 } } },
  { "name": "CRLF line endings", "text": "local:\r\n  mode: open\r\n", "expect": { "local": { "mode": "open" }, "server": null } },
  { "name": "an unknown top-level key", "text": "remote:\n  mode: open\n", "refusedLine": 1 },
  { "name": "an unknown setting", "text": "local:\n  sandbox: true\n", "refusedLine": 2 },
  { "name": "a bad mode", "text": "local:\n  mode: yes\n", "refusedLine": 2 },
  { "name": "a tab", "text": "local:\n\tmode: open\n", "refusedLine": 2 },
  { "name": "a setting outside a section", "text": "  mode: open\n", "refusedLine": 1 },
  { "name": "a setting indented by three", "text": "local:\n   mode: open\n", "refusedLine": 2 },
  { "name": "a duplicate setting", "text": "local:\n  mode: open\n  mode: off\n", "refusedLine": 3 },
  { "name": "a duplicate section", "text": "local:\n  mode: open\nlocal:\n  mode: off\n", "refusedLine": 3 },
  { "name": "a timeout too long", "text": "local:\n  timeout: 61m\n", "refusedLine": 2 },
  { "name": "a timeout with no unit", "text": "local:\n  timeout: 10\n", "refusedLine": 2 },
  { "name": "an output too large", "text": "local:\n  output: 9MiB\n", "refusedLine": 2 },
  { "name": "isolation other than none", "text": "local:\n  isolation: container\n", "refusedLine": 2 },
  { "name": "a variable that is not a name", "text": "local:\n  env:\n    9LIVES: x\n", "refusedLine": 3 },
  { "name": "a value after env", "text": "local:\n  env: x\n", "refusedLine": 2 },
  { "name": "no space after the colon", "text": "local:\n  mode:open\n", "refusedLine": 2 },
  { "name": "shells that is not a flag", "text": "local:\n  shells: yes\n", "refusedLine": 2 },
  { "name": "an unclosed quote", "text": "local:\n  env:\n    A: \"open\n", "refusedLine": 3 },
  { "name": "a variable under env indented by four without env", "text": "local:\n  mode: open\n    A: b\n", "refusedLine": 3 },
  { "name": "caps", "text": "caps:\n  steps: 40\n  budget: 600\n  auto-continue: 3\n", "expect": { "local": null, "server": null, "caps": { "steps": 40, "budget": 600, "autoContinue": 3 } } },
  { "name": "caps beside local", "text": "local:\n  mode: ask\ncaps:\n  steps: 20\n", "expect": { "local": { "mode": "ask" }, "server": null, "caps": { "steps": 20 } } },
  { "name": "an unknown caps setting", "text": "caps:\n  turns: 40\n", "refusedLine": 2 },
  { "name": "a caps value that is not a whole number", "text": "caps:\n  budget: lots\n", "refusedLine": 2 },
  { "name": "steps of zero", "text": "caps:\n  steps: 0\n", "refusedLine": 2 },
  { "name": "auto-continue past a hundred", "text": "caps:\n  auto-continue: 101\n", "refusedLine": 2 },
  { "name": "a caps key under local", "text": "local:\n  steps: 40\n", "refusedLine": 2 },
  { "name": "caps twice", "text": "caps:\n  steps: 4\ncaps:\n  steps: 5\n", "refusedLine": 3 },
  { "name": "a time cap and a failed-checks limit", "text": "caps:\n  time: 90\n  failed-checks: 3\n", "expect": { "local": null, "server": null, "caps": { "time": 90, "failedChecks": 3 } } },
  { "name": "every caps setting", "text": "caps:\n  steps: 40\n  budget: 600\n  auto-continue: 3\n  time: 120\n  failed-checks: 5\n", "expect": { "local": null, "server": null, "caps": { "steps": 40, "budget": 600, "autoContinue": 3, "time": 120, "failedChecks": 5 } } },
  { "name": "a time cap of zero", "text": "caps:\n  time: 0\n", "refusedLine": 2 },
  { "name": "a time cap past a week", "text": "caps:\n  time: 10081\n", "refusedLine": 2 },
  { "name": "failed-checks of zero", "text": "caps:\n  failed-checks: 0\n", "refusedLine": 2 },
  { "name": "failed-checks past a hundred", "text": "caps:\n  failed-checks: 101\n", "refusedLine": 2 },
  { "name": "a time cap written as a duration", "text": "caps:\n  time: 90m\n", "refusedLine": 2 }
]
