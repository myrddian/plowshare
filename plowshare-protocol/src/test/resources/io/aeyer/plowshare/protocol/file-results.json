[
  {"name": "a write makes the directories above the file and reports what it wrote",
   "request": {"op": "write", "path": "{root}/deep/new/A.txt", "content": "one\ntwo\r\nthree"},
   "reply": {"outcome": "ok", "result": {"version": 1, "kind": "written", "op": "write", "path": "{root}/deep/new/A.txt", "bytes": 14, "lines": 3}},
   "after": {"deep/new/A.txt": "one\ntwo\r\nthree"}},
  {"name": "a write of nothing empties the file and reports no lines",
   "files": {"A.txt": "something that was there\n"},
   "request": {"op": "write", "path": "{root}/A.txt", "content": ""},
   "reply": {"outcome": "ok", "result": {"version": 1, "kind": "written", "op": "write", "path": "{root}/A.txt", "bytes": 0, "lines": 0}},
   "after": {"A.txt": ""}},
  {"name": "a create-only write over a file that is there is refused and leaves it",
   "files": {"A.txt": "still here"},
   "request": {"op": "write", "path": "{root}/A.txt", "content": "replaced", "createOnly": true},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "refused", "op": "write", "path": "{root}/A.txt", "reason": "exists"}},
   "after": {"A.txt": "still here"}},
  {"name": "a write onto a directory is refused",
   "dirs": ["src"],
   "request": {"op": "write", "path": "{root}/src", "content": "x"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "refused", "op": "write", "path": "{root}/src", "reason": "directory"}}},
  {"name": "a write with no content is refused rather than emptying the file",
   "files": {"A.txt": "still here"},
   "request": {"op": "write", "path": "{root}/A.txt"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "refused", "op": "write", "reason": "missing", "argument": "content"}},
   "after": {"A.txt": "still here"}},
  {"name": "a write outside the workspace is refused naming the root",
   "request": {"op": "write", "path": "{outside}/A.txt", "content": "x"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "refused", "op": "write", "path": "{outside}/A.txt", "reason": "outside", "roots": ["{root}"]}}},

  {"name": "an edit of a crlf file reports the new text's lines as a read numbers them",
   "files": {"dos.txt": "one\r\ntwo\r\nthree\r\n"},
   "request": {"op": "edit", "path": "{root}/dos.txt", "replacing": "two", "content": "TWO"},
   "reply": {"outcome": "ok", "result": {"version": 1, "kind": "edited", "op": "edit", "path": "{root}/dos.txt", "first": 1, "last": 1, "removed": false,
     "excerpt": {"from": 0, "to": 2, "total": 3, "lines": ["one", "TWO", "three"]}}},
   "after": {"dos.txt": "one\r\nTWO\r\nthree\r\n"}},
  {"name": "an edit that removes text reports where it was",
   "files": {"bare.md": "alpha\nbeta"},
   "request": {"op": "edit", "path": "{root}/bare.md", "replacing": "alpha", "content": ""},
   "reply": {"outcome": "ok", "result": {"version": 1, "kind": "edited", "op": "edit", "path": "{root}/bare.md", "first": 0, "last": 0, "removed": true,
     "excerpt": {"from": 0, "to": 1, "total": 2, "lines": ["", "beta"]}}},
   "after": {"bare.md": "\nbeta"}},
  {"name": "an edit with a look-alike character reports the pair and the file's text",
   "files": {"A.md": "a well-known fact\n"},
   "request": {"op": "edit", "path": "{root}/A.md", "replacing": "well‑known", "content": "famous"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "no-match", "op": "edit", "path": "{root}/A.md", "near": "look-alike",
     "excerpt": {"from": 0, "to": 0, "total": 1, "lines": ["a well-known fact"]}, "differences": [{"sent": 8209, "there": 45}]}},
   "after": {"A.md": "a well-known fact\n"}},
  {"name": "an edit that differs only in indentation reports the file's text",
   "files": {"A.java": "class A {\n    int x = 1;\n}\n"},
   "request": {"op": "edit", "path": "{root}/A.java", "replacing": "class A {\n  int x = 1;", "content": "class A {\n  int x = 2;"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "no-match", "op": "edit", "path": "{root}/A.java", "near": "whitespace",
     "excerpt": {"from": 0, "to": 1, "total": 3, "lines": ["class A {", "    int x = 1;"]}}},
   "after": {"A.java": "class A {\n    int x = 1;\n}\n"}},
  {"name": "an edit of unrelated text reports nothing near it",
