   "request": {"op": "edit", "path": "{root}/A.java", "replacing": "zzz", "content": "x"},
   "reply": {"outcome": "refused", "result": {"version": 1, "kind": "no-match", "op": "edit", "path": "{root}/A.java", "count": 0, "foreign": []}}},
