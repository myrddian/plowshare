    { "name": "capacity-handshake-refuse", "capacity": true, "handshake": true, "delivery": "NOT_SUBMITTED" },
    { "name": "capacity-close-while-parked", "capacity": true, "maxPending": 1, "holdUntilSubmitted": 1, "closeWhileParked": true, "delivery": "UNKNOWN" }
