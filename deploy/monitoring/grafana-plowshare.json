{
  "title": "Plowshare database and operations",
  "uid": "plowshare-db-ops",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Statements per operation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Statements per operation, p50/p95 by kind",
      "description": "Physical JDBC statements issued per tool call, job step and socket request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(plowshare_operation_statements_bucket[5m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(plowshare_operation_statements_bucket[5m])))",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean statements per operation by kind",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(plowshare_operation_statements_sum[5m])) / sum by (kind) (rate(plowshare_operation_statements_count[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "JDBC rate and latency by pool",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Statements per second by pool",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool, outcome) (rate(plowshare_jdbc_statements_seconds_count[5m]))",
          "legendFormat": "{{pool}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mean statement latency by pool",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(plowshare_jdbc_statements_seconds_sum[5m])) / sum by (pool) (rate(plowshare_jdbc_statements_seconds_count[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Authority check outcomes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admission checks by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(plowshare_authority_admission_checks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Session checks by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(plowshare_authority_session_checks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Projection cache",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache hit ratio by line (returns / returns + bypasses)",
      "description": "Useful reuse; loads are attempts and are not counted as returns.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (projection) (rate(plowshare_projection_cache_events_total{event=~\"trusted_hit|versioned_hit|loaded_return\"}[5m])) / sum by (projection) (rate(plowshare_projection_cache_events_total{event=~\"trusted_hit|versioned_hit|loaded_return|bypass_.*\"}[5m]))",
          "legendFormat": "{{projection}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Loads per second by line",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (projection) (rate(plowshare_projection_cache_events_total{event=\"load\"}[5m]))",
          "legendFormat": "{{projection}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Read admission",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Reads active and waiting",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(plowshare_read_active)",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(plowshare_read_waiting)",
          "legendFormat": "waiting"
        },
        {
          "refId": "C",
          "expr": "sum(plowshare_read_fetch_waiting)",
          "legendFormat": "fetch waiting"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Pool saturation wait and rejected reads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(plowshare_pool_admission_saturation_wait_seconds_sum[5m])) / clamp_min(sum(rate(plowshare_pool_admission_saturation_wait_seconds_count[5m])), 1e-9)",
          "legendFormat": "mean saturation wait (s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(plowshare_read_rejected[5m]))",
          "legendFormat": "rejected reads/s"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Hikari pools",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Connections active / pending",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active {{pool}}"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending {{pool}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Connection acquire time (mean)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count[5m]), 1e-9)",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "PostgreSQL statements",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 54
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Top queryid by total execution time (ms/s)",
      "description": "queryid joins to pg-stat-snapshot.sh output; statement text is never exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_statements_total_exec_time_ms[5m]))",
          "legendFormat": "{{queryid}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Top queryid by calls per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_statements_calls[5m]))",
          "legendFormat": "{{queryid}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "Scans",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 63
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Sequential tuples read by table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_user_tables_scans_seq_tup_read[5m]))",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Sequential vs index scans per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_user_tables_scans_seq_scan[5m]))",
          "legendFormat": "sequential"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_user_tables_scans_idx_scan[5m]))",
          "legendFormat": "index"
        }
      ]
    }
  ]
}
