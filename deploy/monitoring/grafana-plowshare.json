{
  "title": "Plowshare database and operations",
  "uid": "plowshare-db-ops",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Statements per operation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Statements per operation, p50/p95 by kind",
      "description": "Physical JDBC statements issued per tool call, job step and socket request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(plowshare_operation_statements_bucket[5m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(plowshare_operation_statements_bucket[5m])))",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean statements per operation by kind",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(plowshare_operation_statements_sum[5m])) / sum by (kind) (rate(plowshare_operation_statements_count[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "JDBC rate and latency by pool",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Statements per second by pool",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool, outcome) (rate(plowshare_jdbc_statements_seconds_count[5m]))",
          "legendFormat": "{{pool}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mean statement latency by pool",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(plowshare_jdbc_statements_seconds_sum[5m])) / sum by (pool) (rate(plowshare_jdbc_statements_seconds_count[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "JDBC execution latency, p95/p99",
      "description": "Includes successful and failed executions. Yellow: 500 ms target; red: 1 s ceiling. Excludes acquisition and result iteration.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(plowshare_jdbc_statements_seconds_bucket[5m])))",
          "legendFormat": "p95 {{pool}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, pool) (rate(plowshare_jdbc_statements_seconds_bucket[5m])))",
          "legendFormat": "p99 {{pool}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Maximum observed JDBC execution latency",
      "description": "Windowed maximum across methods and outcomes, including cancelled executions. This is not a lifetime maximum or a complete query/operation timer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool) (plowshare_jdbc_statements_seconds_max)",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "JDBC executions over 500 ms / 1 s",
      "description": "Exact histogram threshold counts per second, including failed/cancelled executions. Investigate repeated 500 ms breaches; every execution over 1 s violates the request-serving query ceiling. Includes maintenance on these pools.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(plowshare_jdbc_statements_seconds_count[5m])) - sum by (pool) (rate(plowshare_jdbc_statements_seconds_bucket{le=\"0.5\"}[5m]))",
          "legendFormat": ">500 ms {{pool}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pool) (rate(plowshare_jdbc_statements_seconds_count[5m])) - sum by (pool) (rate(plowshare_jdbc_statements_seconds_bucket{le=\"1.0\"}[5m]))",
          "legendFormat": ">1 s {{pool}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "JDBC query cancellations and timeouts",
      "description": "PostgreSQL SQLSTATE 57014 and JDBC SQLTimeoutException. Includes explicit cancellation; this is not solely a deadline-expiry count. A never-seen combination is absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(plowshare_jdbc_cancellations_total[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Authority check outcomes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admission checks by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(plowshare_authority_admission_checks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Session checks by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(plowshare_authority_session_checks_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Projection cache",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache hit ratio by line (returns / returns + bypasses)",
      "description": "Useful reuse; loads are attempts and are not counted as returns.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (projection) (rate(plowshare_projection_cache_events_total{event=~\"trusted_hit|versioned_hit|loaded_return\"}[5m])) / sum by (projection) (rate(plowshare_projection_cache_events_total{event=~\"trusted_hit|versioned_hit|loaded_return|bypass_.*\"}[5m]))",
          "legendFormat": "{{projection}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Loads per second by line",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (projection) (rate(plowshare_projection_cache_events_total{event=\"load\"}[5m]))",
          "legendFormat": "{{projection}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Read admission",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Reads active and waiting",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(plowshare_read_active)",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(plowshare_read_waiting)",
          "legendFormat": "waiting"
        },
        {
          "refId": "C",
          "expr": "sum(plowshare_read_fetch_waiting)",
          "legendFormat": "fetch waiting"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Pool saturation wait and rejected reads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(plowshare_pool_admission_saturation_wait_seconds_sum[5m])) / clamp_min(sum(rate(plowshare_pool_admission_saturation_wait_seconds_count[5m])), 1e-9)",
          "legendFormat": "mean saturation wait (s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(plowshare_read_rejected[5m]))",
          "legendFormat": "rejected reads/s"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Hikari pools",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 62
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Connections active / pending",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active {{pool}}"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending {{pool}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Connection acquire time (mean)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[5m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count[5m]), 1e-9)",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "PostgreSQL statements",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 71
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Top queryid by total execution time (ms/s)",
      "description": "queryid joins to pg-stat-snapshot.sh output; statement text is never exported.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_statements_total_exec_time_ms[5m]))",
          "legendFormat": "{{queryid}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Top queryid by calls per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_statements_calls[5m]))",
          "legendFormat": "{{queryid}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "Scans",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 80
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Sequential tuples read by table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 81
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, rate(pg_user_tables_scans_seq_tup_read[5m]))",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Sequential vs index scans per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 81
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_user_tables_scans_seq_scan[5m]))",
          "legendFormat": "sequential"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_user_tables_scans_idx_scan[5m]))",
          "legendFormat": "index"
        }
      ]
    },
    {
      "id": 25,
      "type": "row",
      "title": "Server failures",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 89
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Handled server failures per second",
      "description": "Failures observed at WebSocket, HTTP and runtime handling boundaries. One incident may affect several boundaries; these are not unique incident counts. Session loss and read capacity are separate kinds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 90
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, source, kind) (rate(plowshare_failures_total[5m]))",
          "legendFormat": "{{instance}} {{source}} {{kind}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "ERROR log entries per second",
      "description": "Counts emitted ERROR-level log entries. Handled availability failures use sampled WARN diagnostics and are visible in the separate failure counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 90
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(logback_events_total{level=\"error\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Failed inference attempts per second",
      "description": "Includes failed upstream attempts even when a later retry succeeds. Retained independently from runtime failure diagnostics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 98
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, lane, operation) (rate(plowshare_inference_attempts_total{outcome=\"failed\"}[5m]))",
          "legendFormat": "{{instance}} {{lane}} {{operation}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Unavailable jobs and lost sessions per second",
      "description": "JobStore task exits. Session loss retains its distinct ending; these counters overlap runtime failure observations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 98
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, ending) (rate(plowshare_jobs_completed_total{ending=~\"unavailable|session_gone\"}[5m]))",
          "legendFormat": "{{instance}} {{ending}}"
        }
      ]
    }
  ]
}
