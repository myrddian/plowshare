# Copy outside the checkout. Never put credentials in this file or the image.
PLOWSHARE_STATE_ROOT=/srv/plowshare
PLOWSHARE_VERSION=0.1.0
# Set the actual revision for prebuilt jars when Git is absent on the Docker host.
PLOWSHARE_SOURCE_REVISION=unknown
PLOWSHARE_ADMIN_HANDLE=admin
# Loopback default; choose the host LAN address to allow remote clients.
PLOWSHARE_LISTEN_ADDRESS=127.0.0.1
PLOWSHARE_PUBLISHED_PORT=8091
# Select this ladder and compose.search.yaml when using SearXNG.
PLOWSHARE_SEARCH_LADDER=searxng
SEARXNG_BASE_URL=http://searxng.example.internal:8888
# Allow the adapter 15 seconds and the server 20 seconds for each provider call.
SEARXNG_TIMEOUT_MS=15000
PLOWSHARE_SEARCH_TIMEOUT=PT20S
