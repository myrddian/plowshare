{
  "name": "plowshare-client-node",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "build/*.js",
    "build/*.d.ts",
    "build/sync/*.js",
    "build/sync/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "plowshare-client-ts": "0.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "@types/ws": "^8.18.1"
  },
  "exports": {
    ".": {
      "types": "./build/sdk.d.ts",
      "import": "./build/sdk.js"
    },
    "./sync/*": {
      "types": "./build/sync/*.d.ts",
      "import": "./build/sync/*.js"
    },
    "./enforcer": {
      "types": "./build/enforcer.d.ts",
      "import": "./build/enforcer.js"
    },
    "./runner": {
      "types": "./build/runner.d.ts",
      "import": "./build/runner.js"
    },
    "./isolation": {
      "types": "./build/isolation.d.ts",
      "import": "./build/isolation.js"
    },
    "./rooter": {
      "types": "./build/rooter.d.ts",
      "import": "./build/rooter.js"
    },
    "./session": {
      "types": "./build/session.d.ts",
      "import": "./build/session.js"
    },
    "./credentials": {
      "types": "./build/credentials.d.ts",
      "import": "./build/credentials.js"
    },
    "./settings": {
      "types": "./build/settings.d.ts",
      "import": "./build/settings.js"
    },
    "./marker": {
      "types": "./build/marker.d.ts",
      "import": "./build/marker.js"
    },
    "./personal": {
      "types": "./build/personal.d.ts",
      "import": "./build/personal.js"
    },
    "./connections": {
      "types": "./build/connections.d.ts",
      "import": "./build/connections.js"
    },
    "./filestores": {
      "types": "./build/filestores.d.ts",
      "import": "./build/filestores.js"
    },
    "./tools": {
      "types": "./build/tools.d.ts",
      "import": "./build/tools.js"
    }
  },
  "description": "Plowshare WebSocket SDK and optional Node platform adapters"
}
